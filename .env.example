# Required for real classification. Keep this server-side only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Neon Postgres connection string. Use the pooled connection string in production.
DATABASE_URL=

# Random 32+ byte string used to HMAC client IPs for rate limiting.
RATE_LIMIT_SECRET=

# Public origin allowed to POST to the API. Leave blank to allow any origin.
APP_ORIGIN=http://localhost:3000

# Test-only mock modes: true, not-waste, low, error. Never enable in production.
MOCK_AI=false

MAX_IMAGE_BYTES=4194304
SCAN_LIMIT_PER_MINUTE=10
SCAN_LIMIT_PER_DAY=100
GLOBAL_SCAN_LIMIT_PER_DAY=500
FEEDBACK_LIMIT_PER_MINUTE=10
FEEDBACK_LIMIT_PER_DAY=50
